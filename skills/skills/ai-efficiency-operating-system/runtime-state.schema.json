  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "goal_hash": {"type": "string", "minLength": 8},
    "task_contract": {"type": "object", "required": ["PRIMARY_TASK", "DESIRED_END_STATE", "HARD_CONSTRAINTS", "ACCEPTANCE_TESTS"], "additionalProperties": true},
    "goal_lineage": {"type": "array", "items": {"type": "object", "required": ["version", "goal_hash", "status"], "properties": {"version": {"type": ["string", "integer"]}, "parent_version": {"type": ["string", "integer", "null"]}, "goal_hash": {"type": "string"}, "status": {"type": "string"}}, "additionalProperties": true}},
    "identity_lock": {"type": ["object", "null"], "additionalProperties": true},
    "instruction_scope_manifest": {"type": "array", "items": {"type": "object"}},
    "instruction_provenance_ledger": {"type": "array", "items": {"type": "object"}},
    "context_manifest": {"type": "array", "items": {"type": "object"}},
    "context_lineage": {"type": "array", "items": {"type": "object", "required": ["context_id"], "properties": {"context_id": {"type": "string"}, "parent_context_id": {"type": ["string", "null"]}, "checkpoint_id": {"type": ["string", "null"]}, "goal_hash": {"type": ["string", "null"]}, "inherited_digest": {"type": ["string", "null"]}, "local_delta_digest": {"type": ["string", "null"]}, "reconciled": {"type": "boolean"}}, "additionalProperties": true}},
    "memory_authority": {"type": "array", "items": {"type": "object", "required": ["memory_id", "authority", "status"], "properties": {"memory_id": {"type": "string"}, "content_hash": {"type": ["string", "null"]}, "source_kind": {"type": ["string", "null"]}, "authority": {"type": "string"}, "authority_ceiling": {"type": ["string", "number", "integer", "null"]}, "derived_from": {"type": "array", "items": {"type": "string"}}, "provenance": {"type": ["string", "null"]}, "scope": {"type": ["string", "null"]}, "version": {"type": ["string", "null"]}, "retest_triggers": {"type": "array", "items": {"type": "string"}}, "recurrence_count": {"type": "integer", "minimum": 0}, "status": {"type": "string"}}, "additionalProperties": true}},
    "input_fidelity": {"type": ["object", "null"], "additionalProperties": true},
    "tool_route": {"type": "array", "items": {"type": "object"}},
    "protocol_contracts": {"type": "array", "items": {"type": "object", "required": ["protocol", "protocol_version"], "additionalProperties": true}},
    "agent_receipts": {"type": "array", "items": {"type": "object"}},
    "workstream_receipts": {"type": "array", "items": {"type": "object"}},
    "hypothesis_ledger": {"type": "array", "items": {"type": "object"}},
    "evidence_ledger": {"type": "array", "items": {"type": "object"}},
    "evidence_clusters": {"type": "array", "items": {"type": "object", "required": ["cluster_id", "stance"], "properties": {"cluster_id": {"type": "string"}, "stance": {"enum": ["SUPPORT", "REFUTE", "UNKNOWN"]}, "provenance_family": {"type": ["string", "null"]}, "model_lineage": {"type": ["string", "null"]}, "prompt_lineage": {"type": ["string", "null"]}, "evidence_route": {"type": ["string", "null"]}, "independence_key": {"type": ["string", "null"]}, "member_evidence_ids": {"type": "array", "items": {"type": "string"}}, "additionalProperties": true}},
    "event_journal": {"type": "array", "items": {"type": "object"}},
    "failed_turn_quarantine": {"type": "array", "items": {"type": "object", "required": ["turn_id", "reason", "state"], "properties": {"turn_id": {"type": "string"}, "reason": {"type": "string"}, "state": {"const": "QUARANTINED"}, "may_replay": {"type": "boolean"}}, "additionalProperties": true}},
    "authority_lineage": {"type": "array", "items": {"type": "object", "required": ["grant_id", "generation", "subject", "goal_version", "capability", "semantic_scope", "status"], "properties": {"grant_id": {"type": "string"}, "run_id": {"type": ["string", "null"]}, "generation": {"type": "integer", "minimum": 0}, "subject": {"type": "string"}, "goal_version": {"type": ["string", "integer"]}, "owner_epoch": {"type": ["integer", "null"]}, "capability": {"type": "string"}, "semantic_scope": {"type": "string"}, "mode": {"enum": ["ONE_SHOT", "LEASED", "PERSISTENT"]}, "expires_at": {"type": ["string", "null"]}, "parent_grant": {"type": ["string", "null"]}, "status": {"type": "string"}}, "additionalProperties": true}},
    "effect_ledger": {"type": "array", "items": {"type": "object", "required": ["semantic_action_key", "goal_version", "tool", "semantic_scope", "state"], "properties": {"semantic_action_key": {"type": "string"}, "goal_version": {"type": ["string", "integer"]}, "tool": {"type": "string"}, "semantic_scope": {"type": "string"}, "state": {"enum": ["PREPARED", "EXECUTING", "SENT", "ACKED", "VERIFIED", "UNKNOWN", "FAILED", "CANCELLED"]}, "replay_class": {"enum": ["READ_ONLY", "IDEMPOTENT", "IRREVERSIBLE", "UNKNOWN"]}, "dispatch_receipt": {"type": ["string", "null"]}, "readback_receipt": {"type": ["string", "null"]}}, "additionalProperties": true}},
    "interaction_topology": {"type": "array", "items": {"type": "object", "required": ["run_id", "interaction_mode"], "properties": {"run_id": {"type": "string"}, "parent_run_id": {"type": ["string", "null"]}, "interaction_mode": {"enum": ["INTERACTIVE_LOCAL", "OUTER_RUN_INTERRUPT", "PROGRAMMATIC_RESOLVER", "NON_INTERACTIVE_FAIL_CLOSED", "MANAGED_AUTO_REVIEW", "HOST_DEFINED", "UNKNOWN"]}, "approval_policy": {"type": ["string", "null"]}, "permission_policy": {"type": ["string", "null"]}, "input_request_policy": {"type": ["string", "null"]}, "auth_login_prompt_policy": {"type": ["string", "null"]}, "skill_dependency_prompt_policy": {"type": ["string", "null"]}, "responder_identity": {"type": ["string", "null"]}, "responder_channel": {"type": ["string", "null"]}, "channel_reachable": {"type": ["boolean", "null"]}, "channel_authority": {"type": ["string", "null"]}, "timeout_cancel_contract": {"type": ["string", "null"]}, "fallback_contract": {"type": ["string", "null"]}}, "additionalProperties": true}},
    "delivery_ledger": {"type": "array", "items": {"type": "object", "required": ["delivery_id", "state"], "properties": {"delivery_id": {"type": "string"}, "state": {"enum": ["SENT", "DELIVERED", "ACKNOWLEDGED", "INCORPORATED", "VERIFIED"]}, "sender": {"type": ["string", "null"]}, "receiver": {"type": ["string", "null"]}, "observer": {"type": ["string", "null"]}, "expected_hash": {"type": ["string", "null"]}, "generation": {"type": ["string", "integer", "null"]}, "receipt": {"type": ["string", "null"]}}, "additionalProperties": true}},
    "observation_cache_index": {"type": "array", "items": {"type": "object"}},
    "retry_state": {"type": "array", "items": {"type": "object"}},
    "circuit_breakers": {"type": "array", "items": {"type": "object"}},
    "writer_lease": {"type": ["object", "null"]},
    "idempotency_ledger": {"type": "array", "items": {"type": "object"}},
    "mutation_receipts": {"type": "array", "items": {"type": "object"}},
    "verifier_registry": {"type": "array", "items": {"type": "object", "required": ["name", "version", "admitted"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "canary_suite_ref": {"type": ["string", "null"]}, "false_accept_budget": {"type": ["number", "null"]}, "false_reject_budget": {"type": ["number", "null"]}, "admitted": {"type": "boolean"}, "admission_receipt": {"type": ["string", "null"]}}, "additionalProperties": true}},
    "verifier_receipts": {"type": "array", "items": {"type": "object"}},
    "abstention_ledger": {"type": "array", "items": {"type": "object", "required": ["decision_id", "decision"], "properties": {"decision_id": {"type": "string"}, "step": {"type": ["integer", "string", "null"]}, "decision": {"enum": ["ACT", "ABSTAIN", "GATHER"]}, "trigger": {"type": ["string", "null"]}, "irreversible_effect_before_decision": {"type": "boolean"}, "receipt": {"type": ["string", "null"]}}, "additionalProperties": true}},
    "tool_adjudications": {"type": "array", "items": {"type": "object", "required": ["claim_id", "decision"], "properties": {"claim_id": {"type": "string"}, "tool_output_ref": {"type": ["string", "null"]}, "judgment": {"type": ["string", "null"]}, "independent_evidence_refs": {"type": "array", "items": {"type": "string"}}, "decision": {"type": "string"}, "receipt": {"type": ["string", "null"]}}, "additionalProperties": true}},
    "skill_lifecycle": {"type": "array", "items": {"type": "object", "required": ["skill_id", "status"], "properties": {"skill_id": {"type": "string"}, "target_model": {"type": ["string", "null"]}, "target_host": {"type": ["string", "null"]}, "marginal_contribution": {"type": ["number", "null"]}, "status": {"enum": ["RETAIN", "RETIRE", "EXPAND", "ADAPT", "HOLD"]}, "eval_receipt": {"type": ["string", "null"]}}, "additionalProperties": true}},
    "handoff_envelopes": {"type": "array", "items": {"type": "object", "required": ["handoff_id", "goal_version", "canonical_core_digest"], "properties": {"handoff_id": {"type": "string"}, "goal_version": {"type": ["string", "integer"]}, "canonical_core_digest": {"type": "string"}, "successor_profile": {"type": ["string", "null"]}, "successor_view_digest": {"type": ["string", "null"]}, "artifact_hashes": {"type": "array", "items": {"type": "string"}}, "pending_obligations": {"type": "array", "items": {"type": "string"}}, "receipts": {"type": "array", "items": {"type": "string"}}, "additionalProperties": true}},
    "lifecycle_receipts": {"type": "array", "items": {"type": "object", "required": ["state"], "properties": {"state": {"enum": ["SCHEDULED", "DISPATCHED", "STARTED", "EFFECT_OBSERVED", "COMPLETED", "DELIVERED", "ACKED"]}, "receipt": {"type": ["string", "null"]}, "observed_at": {"type": ["string", "null"]}}, "additionalProperties": true}},
    "distribution_parity_receipts": {"type": "array", "items": {"type": "object", "required": ["artifact", "verdict"], "properties": {"artifact": {"type": "string"}, "path": {"type": ["string", "null"]}, "source_hash": {"type": ["string", "null"]}, "packaged_hash": {"type": ["string", "null"]}, "installed_hash": {"type": ["string", "null"]}, "source_size": {"type": ["integer", "null"]}, "packaged_size": {"type": ["integer", "null"]}, "installed_size": {"type": ["integer", "null"]}, "verdict": {"enum": ["PASS", "FAIL", "BLOCKED", "UNVERIFIED"]}}, "additionalProperties": true}},
    "alternate_path_checks": {"type": "array", "items": {"type": "object"}},
    "temporal_witnesses": {"type": "array", "items": {"type": "object"}},
    "rollback_target": {"type": ["object", "string", "null"]},
    "completion_state": {"enum": ["DRAFTED", "PACKAGED", "IMPLEMENTED", "TESTED", "VERIFIED", "HOST_LIVE", "DEPLOYED", "HEALTHY"]},
    "pending_obligations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
