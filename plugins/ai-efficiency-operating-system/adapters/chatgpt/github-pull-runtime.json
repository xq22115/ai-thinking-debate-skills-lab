    "tool_error_must_preserve_error_code_and_target_identity": true,
    "partial_success_must_not_be_promoted_to_pass": true,
    "ambiguous_result_must_not_drive_blind_material_chaining": true,
    "unknown_fields_or_response_shape_change_must_be_classified_before_retry": true,
    "evidence_delta_must_be_recorded_after_failed_or_inconclusive_attempt": true
