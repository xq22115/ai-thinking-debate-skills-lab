  "write_contract": {
    "prewrite_read_required": true,
    "base_revision_and_rollback_required": true,
    "current_blob_sha_required_for_update_or_delete": true,
    "isolated_branch_preferred_for_nontrivial_change": true,
    "dependent_same_path_writes_must_be_sequential": true,
    "stale_blob_sha_conflict_is_expected_detectable_failure": true,
    "readback_after_material_write": true,
    "readback_must_match_target_branch_and_intended_content": true,
    "complete_changed_file_set_must_be_inspected_before_release": true,
    "commit_sha_alone_is_not_completion": true,
    "rollback_revision_recorded_before_first_write": true
