  "execution_contract": {
    "repository_state_is_not_runtime_execution": true,
    "workflow_dispatch_is_not_execution_success": true,
    "green_workflow_is_bound_to_its_exact_run_and_commit": true,
    "configuration_is_not_installation": true,
    "installation_is_not_invocation": true,
    "invocation_is_not_observable_effect": true,
    "requested_execution_requires_observed_execution_when_capability_available": true,
    "unobservable_required_execution_is_blocked_or_not_run_not_pass": true
