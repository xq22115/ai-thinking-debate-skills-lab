{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.schema.json",
  "title": "Actor ownership claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_number",
    "run_id",
    "actor_id",
    "branch",
    "base_sha",
    "claim_id",
    "executor_id",
    "execution_id",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "claim_id": {
      "type": "string",
      "minLength": 8
    },
    "executor_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "CLAIMED"
    }
  }
}
