{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub Agent Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["issue_number", "title", "goal", "repository", "base_sha", "acceptance", "risk_level"],
  "properties": {
    "issue_number": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "risk_level": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "dependencies": {"type": "array", "items": {"type": "integer", "minimum": 1}}
  }
}
