{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "write-plan.schema.json",
  "title": "Multi-chat write plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_number",
    "run_id",
    "actor_id",
    "branch",
    "base_sha",
    "write_set",
    "depends_on",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "read_set": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "write_set": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "PROPOSED",
        "APPROVED",
        "BLOCKED"
      ]
    }
  }
}
