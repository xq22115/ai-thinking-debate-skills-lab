PORT=3000
BIND_HOST=127.0.0.1
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_BEARER_TOKEN=
MCP_ALLOW_UNAUTHENTICATED_REMOTE=false
ORDINARY_CHAT_MCP_ALLOW_SUBMIT=false
PYTHON_BIN=python3

# Local bridge settings. Use OS path separators between multiple roots.
ORDINARY_CHAT_ALLOWED_ROOTS=/absolute/project/root
ORDINARY_CHAT_STATE_DIR=~/.ordinary-chat-agent
CHAT_WORK_AGENT_PATH=/Users/your-user/Library/Application Support/Parall/ChatGPT-Account2/.codex/bin/chat-work-agent
CLAUDE_PATH=/absolute/path/to/claude
CHAT_WORK_AGENT_TIMEOUT_SECONDS=7200
