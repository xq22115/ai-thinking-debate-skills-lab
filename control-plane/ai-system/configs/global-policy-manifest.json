{
  "schema_version": 1,
  "profile_id": "global-policy-durability-v1",
  "canonical_repository": "xq22115/ai-thinking-debate-skills-lab",
  "objective": "keep global AI behavior durable, inspectable, rehydratable, and resistant to silent instruction decay without bloating every model context",
  "kernel": {
    "path": "docs/GLOBAL_POLICY_KERNEL.md",
    "load_mode": "always_when_host_supports_project_or_user_instructions",
    "max_bytes": 8192,
    "semantic_owner": "global_bootstrap"
  },
  "entrypoints": [
    {
      "path": "AGENTS.md",
      "role": "repository_bootstrap",
      "required_markers": [
        "GLOBAL_POLICY_KERNEL.md",
        "global-policy-manifest.json",
        "ai-efficiency-operating-system"
      ]
    },
    {
      "path": "control-plane/scripts/install_codex_global_quality.py",
      "role": "codex_user_level_projection",
      "required_markers": [
        "No silent policy decay",
        "Rehydrate",
        "Truth lock"
      ]
    }
  ],
  "canonical_policies": [
    {
      "id": "continuous-thinking-quality",
      "path": "docs/CONTINUOUS_THINKING_QUALITY_OS.md",
      "semantic_owner": "reasoning_quality",
      "load_mode": "material_or_critical_task"
    },
    {
      "id": "continuous-thinking-machine",
      "path": "control-plane/ai-system/configs/continuous-thinking-global.json",
      "semantic_owner": "reasoning_quality_machine_contract",
      "load_mode": "material_or_critical_task"
    },
    {
      "id": "capability-flexibility",
      "path": "docs/CAPABILITY_ACCESS_AND_FLEXIBILITY_POLICY.md",
      "semantic_owner": "capability_and_anti_overrefusal",
      "load_mode": "task_relevant"
    },
    {
      "id": "capability-routing-machine",
      "path": "control-plane/ai-system/configs/context-first-capability-routing.json",
      "semantic_owner": "capability_and_anti_overrefusal_machine_contract",
      "load_mode": "task_relevant"
    },
    {
      "id": "desktop-execution",
      "path": "docs/DESKTOP_AGENT_EXECUTION_POLICY.md",
      "semantic_owner": "desktop_execution",
      "load_mode": "desktop_or_local_task"
    },
    {
      "id": "desktop-execution-machine",
      "path": "control-plane/ai-system/configs/desktop-agent-execution-global.json",
      "semantic_owner": "desktop_execution_machine_contract",
      "load_mode": "desktop_or_local_task"
    },
    {
      "id": "ai-efficiency-operating-system",
      "path": "skills/skills/ai-efficiency-operating-system/SKILL.md",
      "semantic_owner": "cross_chat_hidden_state_and_execution_orchestration",
      "load_mode": "progressive_disclosure_for_complex_or_cross_chat_work"
    }
  ],
  "rehydration": {
    "required": true,
    "triggers": [
      "session_or_thread_start_when_loader_is_available",
      "context_compaction_or_summary_replacement",
      "cwd_repository_workspace_or_surface_change",
      "instruction_or_policy_revision_change",
      "active_instruction_provenance_unknown",
      "contradiction_between_memory_summary_tools_and_current_state",
      "after_failed_turn_or_partial_stream_before_reuse",
      "before_material_write_when_active_rules_cannot_be_proven_loaded"
    ],
    "procedure": [
      "resolve_host_surface_and_target_identity",
      "inventory_active_instruction_sources_and_precedence",
      "load_kernel",
      "load_only_task_relevant_manifest_entries",
      "restore_goal_contract_open_gates_failed_routes_and_evidence_index",
      "quarantine_failed_or_stale_context",
      "record_loaded_policy_revision_and_source_provenance",
      "continue_only_after_required_invariants_are_present"
    ],
    "silent_drop_forbidden": true,
    "unknown_policy_state": "UNKNOWN_NOT_COMPLIANT"
  },
  "context_budget": {
    "progressive_disclosure_required": true,
    "discover_many_load_few": true,
    "root_agents_soft_target_bytes": 20000,
    "root_agents_hard_max_bytes": 24576,
    "reason": "maintain margin below reported Codex AGENTS.md truncation behavior and reduce context competition"
  },
  "instruction_provenance": {
    "required_fields": [
      "source",
      "scope",
      "precedence_or_merge_rule",
      "revision_or_content_hash_when_available",
      "loaded_state",
      "retest_trigger"
    ],
    "loaded_states": [
      "DISCOVERED",
      "FETCHED",
      "LOADED",
      "APPLIED",
      "UNKNOWN"
    ],
    "repository_presence_is_not_loaded": true
  },
  "durable_state": {
    "chat_history_is_not_canonical": true,
    "summary_is_cache_not_authority": true,
    "failed_turn_quarantine": true,
    "atomic_or_idempotent_persistence_preferred": true,
    "preserve_after_compaction": [
      "ROOT_GOAL",
      "DESIRED_END_STATE",
      "HARD_CONSTRAINTS",
      "NEGATIONS",
      "ACCEPTANCE_TESTS",
      "protected_capabilities",
      "CURRENT_BLOCKER",
      "NEXT_ACTION",
      "open_unknowns",
      "failed_routes",
      "evidence_index",
      "contradictions",
      "pending_effects",
      "rollback_target",
      "completion_gate",
      "jury_status",
      "active_policy_revision"
    ]
  },
  "platform_truth": {
    "codex_repo_agents": "can be auto-discovered by Codex within its documented scope but must still be verified as loaded for material compliance claims",
    "codex_user_global": "managed through the repository installer into the active CODEX_HOME instruction file when explicitly installed",
    "ordinary_chat": "repository files are not inherently global instructions; persistence requires a host-supported memory/project instruction mechanism or explicit connector retrieval",
    "skills": "progressive disclosure; a skill existing on disk or in a repository does not prove its body was loaded"
  },
  "drift_gate": {
    "manifest_paths_must_exist": true,
    "entrypoint_markers_must_exist": true,
    "kernel_must_fit_budget": true,
    "root_agents_must_fit_hard_budget": true,
    "canonical_policy_ids_unique": true,
    "semantic_owner_collisions_forbidden": true,
    "fail_if_global_entrypoint_loses_manifest": true,
    "fail_if_installer_loses_durability_kernel": true
  }
}
