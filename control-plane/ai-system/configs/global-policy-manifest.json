  ],
  "rehydration": {
    "required": true,
    "triggers": [
      "session_or_thread_start_when_loader_is_available",
      "context_compaction_or_summary_replacement",
      "cwd_repository_workspace_or_surface_change",
      "instruction_or_policy_revision_change",
      "active_instruction_provenance_unknown",
      "contradiction_between_memory_summary_tools_and_current_state",
      "after_failed_turn_or_partial_stream_before_reuse",
      "before_material_write_when_active_rules_cannot_be_proven_loaded"
    ],
    "procedure": [
      "resolve_host_surface_and_target_identity",
      "inventory_active_instruction_sources_and_precedence",
      "load_kernel",
      "load_only_task_relevant_manifest_entries",
      "load_task_goal_portable_base_v3_extension_and_v31_truth_maintenance_for_substantive_tasks",
      "restore_root_goal_underlying_purpose_goal_signature_acceptance_contract_open_gates_failed_routes_and_evidence_index",
      "restore_goal_version_event_log_intent_belief_authority_uncertainty_traceability_progress_and_counterexample_state",
      "quarantine_failed_or_stale_context",
      "record_loaded_policy_revision_and_source_provenance",
      "continue_only_after_required_invariants_are_present"
    ],
    "silent_drop_forbidden": true,
    "unknown_policy_state": "UNKNOWN_NOT_COMPLIANT"
  },
  "context_budget": {
    "progressive_disclosure_required": true,
    "discover_many_load_few": true,
    "root_agents_soft_target_bytes": 20000,
    "root_agents_hard_max_bytes": 24576,
    "reason": "maintain margin below reported Codex AGENTS.md truncation behavior and reduce context competition"
  },
  "instruction_provenance": {
    "required_fields": [
      "source",
      "scope",
      "precedence_or_merge_rule",
      "revision_or_content_hash_when_available",
      "loaded_state",
      "retest_trigger"
    ],
    "loaded_states": [
      "DISCOVERED",
      "FETCHED",
      "LOADED",
      "APPLIED",
      "UNKNOWN"
    ],
    "repository_presence_is_not_loaded": true
  },
  "durable_state": {
    "chat_history_is_not_canonical": true,
    "summary_is_cache_not_authority": true,
    "failed_turn_quarantine": true,
    "atomic_or_idempotent_persistence_preferred": true,
    "preserve_after_compaction": [
      "ROOT_GOAL",
      "UNDERLYING_PURPOSE",
      "GOAL_SIGNATURE",
      "GOAL_VERSION",
      "GOAL_FINGERPRINT",
      "GOAL_EVENT_LOG",
      "DESIRED_END_STATE",
      "HARD_CONSTRAINTS",
      "NEGATIONS",
      "ACCEPTANCE_TESTS",
      "protected_capabilities",
      "TARGET_IDENTITY",
      "INTENT_BELIEF_GRAPH",
      "ASSUMPTION_LEDGER",
      "authority_ledger",
      "uncertainty_ledger",
      "traceability_matrix",
      "progress_ledger",
      "invalidated_goal_nodes",
      "counterexamples",
      "historical_claims",
      "CURRENT_BLOCKER",
      "NEXT_ACTION",
      "open_unknowns",
      "failed_routes",
      "evidence_index",
      "contradictions",
      "pending_effects",
      "rollback_target",
      "completion_gate",
      "jury_status",
      "active_policy_revision"
    ]
  },
  "platform_truth": {
    "codex_repo_agents": "can be auto-discovered by Codex within its documented scope but must still be verified as loaded for material compliance claims",
    "codex_user_global": "managed through the repository installer into the active CODEX_HOME instruction file when explicitly installed",
    "antigravity_workspace": "workspace rules, hooks, and the five recovery subagents are projected through .agents/rules, .agents/hooks.json, and .agents/agents; repository presence still requires Antigravity to open or mount the owning workspace before claiming them loaded",
    "antigravity_user_global": "machine-wide rule content lives in ~/.gemini/GEMINI.md and machine-wide custom subagents live in ~/.gemini/config/agents; both are projected with backups by control-plane/scripts/install_antigravity_global_goal_lock.py, which must be executed and read back on the target machine before claiming global load",
    "ordinary_chat": "repository files are not inherently global instructions; current ChatGPT plugin use still requires the plugin/marketplace to be imported or installed on the owning workspace/surface, or another host-supported memory/project instruction mechanism",
    "skills": "progressive disclosure; a skill existing on disk or in a repository does not prove its body was loaded"
  },
  "drift_gate": {
    "manifest_paths_must_exist": true,
    "entrypoint_markers_must_exist": true,
    "kernel_must_fit_budget": true,
    "root_agents_must_fit_hard_budget": true,
    "canonical_policy_ids_unique": true,
    "semantic_owner_collisions_forbidden": true,
    "fail_if_global_entrypoint_loses_manifest": true,
    "fail_if_installer_loses_durability_kernel": true
  }
}
