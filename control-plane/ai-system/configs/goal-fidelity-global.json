{
  "schema_version": 2,
  "profile_id": "goal-intelligence-target-lock-v2",
  "scope": "global-policy-projection",
  "default_enabled": true,
  "purpose": "Recover, track, and verify the user's operative task goal as a live evidence-backed belief model before and during execution.",
  "goal_contract": {
    "required_fields": [
      "ROOT_GOAL",
      "DESIRED_END_STATE",
      "HARD_CONSTRAINTS",
      "NEGATIONS",
      "PROTECTED_CAPABILITIES",
      "TARGET_IDENTITY",
      "ACCEPTANCE_TESTS",
      "UNDERLYING_PURPOSE",
      "PREFERENCE_PROFILE",
      "DECISION_CRITICAL_UNKNOWNS",
      "ASSUMPTION_LEDGER",
      "GOAL_SIGNATURE"
    ],
    "target_identity_dimensions": [
      "host",
      "account_or_profile",
      "application_or_runtime",
      "repository_or_workspace",
      "path_or_resource",
      "process_window_or_session",
      "revision_or_version_when_relevant"
    ],
    "route_may_change_without_goal_change": true,
    "silent_goal_mutation_forbidden": true
  },
  "intent_inference": {
    "intent_belief_graph_required_for_substantive_tasks": true,
    "node_types": [
      "desired_outcome",
      "explicit_requirement",
      "inferred_preference",
      "negative_constraint",
      "target_entity",
      "dependency",
      "causal_owner",
      "acceptance_evidence",
      "open_unknown",
      "assumption",
      "obsolete_constraint",
      "evidence_provenance"
    ],
    "edge_types": [
      "requires",
      "supports",
      "contradicts",
      "depends_on",
      "owned_by",
      "verified_by",
      "supersedes",
      "derived_from"
    ],
    "candidate_goal_limit": 3,
    "candidate_goal_scoring_dimensions": [
      "literal_wording_and_corrections",
      "durable_context_and_preferences",
      "environment_entity_evidence",
      "causal_ownership",
      "constraint_compatibility",
      "acceptance_coverage",
      "underlying_purpose",
      "contradiction_count",
      "unsupported_assumption_cost"
    ],
    "low_confidence_hidden_intent_may_not_become_hard_requirement": true,
    "semantic_delta_required_on_each_user_turn": true,
    "semantic_delta_classes": [
      "refinement",
      "new_constraint",
      "correction",
      "priority_change",
      "target_entity_change",
      "route_preference_change",
      "acceptance_test_change",
      "related_goal_pivot",
      "full_task_switch",
      "non_substantive_restatement"
    ],
    "superseded_constraints_marked_obsolete": true,
    "stale_constraints_may_not_silently_survive_intent_shift": true
  },
  "primary_gate": {
    "minimum_independent_analyzers": 5,
    "analyzers": [
      "literal_intent",
      "environment_entity_identity",
      "acceptance_evidence_backward",
      "causal_dependency_owner",
      "reverse_failure"
    ],
    "required_output_fields": [
      "interpretation",
      "evidence",
      "uncertainty",
      "contradictions",
      "confidence"
    ],
    "cosmetic_rewording_does_not_count_as_independence": true
  },
  "escalation_gate": {
    "trigger_conditions": [
      "high_impact_field_disagreement",
      "insufficient_confidence",
      "ambiguous_target_identity",
      "contradictory_high_signal_evidence",
      "candidate_goals_imply_materially_different_actions"
    ],
    "additional_analyzers": [
      "counterfactual",
      "exclusion",
      "cross_source_consistency",
      "purpose_value",
      "intent_delta"
    ],
    "minimum_total_high_impact_analyzers": 10,
    "guessing_on_high_impact_ambiguity_forbidden": true
  },
  "information_gain_routing": {
    "enabled": true,
    "unknown_priority_factors": [
      "impact_if_wrong",
      "current_uncertainty",
      "observation_cost",
      "candidate_discrimination_power",
      "tool_resolvability"
    ],
    "select_next_observation_by_expected_decision_value": true,
    "prefer_tool_evidence_when_reliable": true,
    "clarification_allowed_anytime": true,
    "ask_user_only_when_available_evidence_cannot_resolve_material_ambiguity": true,
    "never_ask_user_to_repeat_known_information": true,
    "clarification_question_must_target_highest_value_remaining_ambiguity": true,
    "generic_low_information_clarification_discouraged": true
  },
  "research_evidence_mesh": {
    "enabled_for_research_heavy_tasks": true,
    "distinct_lane_target": 20,
    "do_not_pad_with_duplicate_or_derivative_sources": true,
    "lanes": [
      "canonical_spec",
      "repository_source",
      "config_and_schema_defaults",
      "release_notes_and_changelogs",
      "commit_archaeology",
      "issue_history",
      "pull_request_discussions",
      "regression_tests_and_fixtures",
      "benchmark_methodology_and_raw_metrics",
      "dataset_cards_and_eval_sets",
      "paper_and_citation_chaining",
      "maintainer_comments_and_design_proposals",
      "respected_practitioner_implementations",
      "postmortems_and_incident_reports",
      "negative_evidence_and_failure_reports",
      "abandoned_or_reverted_approaches",
      "version_incompatibility_and_migration_reports",
      "competing_implementations",
      "reverse_search_from_errors_symbols_or_files",
      "long_term_reproducible_user_reports",
      "prompt_and_config_archaeology",
      "package_and_release_metadata",
      "benchmark_counterexamples_or_hidden_test_style_evals",
      "niche_sources_discovered_by_citation_maintainer_or_commit_linkage"
    ],
    "rare_signal_policy": {
      "obscurity_is_not_quality": true,
      "prefer_when_it_resolves_contradiction_or_changes_decision": true,
      "negative_evidence_required_before_reliability_claim": true
    }
  },
  "planning_gate": {
    "detailed_plan_requires_sufficient_goal_convergence": true,
    "required_convergence_fields": [
      "ROOT_GOAL",
      "TARGET_IDENTITY",
      "HARD_CONSTRAINTS",
      "PROTECTED_CAPABILITIES",
      "DECISION_CRITICAL_UNKNOWNS",
      "ACCEPTANCE_TESTS"
    ],
    "each_material_step_must_map_to": [
      "goal_node",
      "hard_constraint",
      "material_unknown",
      "acceptance_test"
    ],
    "unmapped_steps_are_non_progress_candidates": true
  },
  "drift_control": {
    "goal_signature_required": true,
    "intent_belief_graph_recheck_required": true,
    "checkpoint_triggers": [
      "before_first_material_write_or_external_action",
      "after_material_route_change",
      "after_two_similar_failures",
      "host_account_repo_workspace_path_or_session_change",
      "context_compaction_summary_handoff_or_branch_merge",
      "after_user_correction_or_intent_shift",
      "before_release"
    ],
    "protected_fields": [
      "ROOT_GOAL",
      "HARD_CONSTRAINTS",
      "NEGATIONS",
      "PROTECTED_CAPABILITIES",
      "TARGET_IDENTITY",
      "ACCEPTANCE_TESTS"
    ],
    "drift_requires_explicit_evidence": true,
    "heartbeat_after_material_tool_calls_approx": 5,
    "heartbeat_fields": [
      "active_goal",
      "changed_constraints",
      "unresolved_unknowns",
      "next_discriminating_action",
      "acceptance_progress"
    ]
  },
  "anti_evasion_control": {
    "stop_or_block_event_does_not_change_root_goal": true,
    "controller_hook_or_guard_is_not_promoted_to_task_target": true,
    "current_blocker_is_recorded_separately_from_root_goal": true,
    "goal_signature_must_survive_stop_retry_and_recovery": true,
    "forbidden_progress_substitutions": [
      "inspect_exploit_bypass_kill_or_weaken_controller_to_escape_work",
      "game_string_checks_or_completion_detectors",
      "satisfy_agent_headcount_without_unique_goal_advancing_contribution",
      "substitute_refusal_policy_or_ethics_debate_for_allowed_task_progress",
      "fabricate_runtime_independence_execution_or_completion",
      "reduce_required_effort_agent_count_tests_or_acceptance_criteria_to_escape_a_blocker"
    ],
    "on_block": {
      "required_next_step": "highest_value_goal_advancing_action_available_under_current_constraints",
      "route_pivot_is_preferred_over_goal_pivot": true,
      "blocker_may_not_become_root_goal": true,
      "non_progress_actions_do_not_satisfy_stop_or_completion_gates": true,
      "if_one_route_is_unavailable": "change_method_layer_instrument_or_decomposition_without_lowering_acceptance_tests"
    },
    "multi_agent_contribution_gate": {
      "headcount_alone_never_satisfies_requirement": true,
      "each_activated_agent_requires_distinct_role": true,
      "each_activated_agent_requires_unique_evidence_test_artifact_or_implementation_contribution": true,
      "contribution_must_map_to_goal_contract_or_acceptance_test": true,
      "policy_only_or_refusal_only_agent_does_not_count_unless_policy_analysis_is_the_user_task": true,
      "runtime_independence_must_be_observed_before_claimed": true
    }
  },
  "completion_audit": {
    "independent_audit_preferred_when_practical": true,
    "auditor_inputs": [
      "original_goal_contract",
      "current_intent_belief_graph",
      "actual_tool_or_runtime_evidence",
      "acceptance_tests",
      "unresolved_contradictions_and_assumptions"
    ],
    "weighted_acceptance_coverage": true,
    "hard_requirements_have_veto_power": true,
    "self_report_only_cannot_pass": true
  },
  "evidence_mesh": {
    "default_sources_for_substantive_tasks_when_available": [
      "GitHub",
      "Notion",
      "Hugging Face"
    ],
    "github_role": "executable_source_of_truth",
    "notion_role": "durable_cross_repo_context_and_decision_memory",
    "hugging_face_role": "model_dataset_benchmark_and_research_evidence",
    "start_with_low_cost_relevance_probe": true,
    "deepen_by_information_gain": true,
    "connector_use_must_be_observed_not_assumed": true,
    "unavailable_or_irrelevant_connector_must_not_block_unrelated_work": true
  },
  "capability_preservation": {
    "obvious_degradation_is_not_default_solution": true,
    "must_search_for_capability_preserving_route_first": true,
    "protected_capability_regression_blocks_pass": true,
    "requested_reasoning_effort_or_agent_budget_must_not_be_reduced_as_an_evasion_strategy": true
  },
  "evaluation": {
    "required_scenario_classes": [
      "fully_specified",
      "underspecified",
      "ambiguous_entity",
      "hidden_requirement",
      "mid_task_refinement",
      "full_intent_switch",
      "conflicting_prior_context",
      "stale_constraints",
      "tool_disproves_leading_interpretation",
      "tool_resolvable_without_user_question",
      "single_high_information_clarification_required"
    ],
    "metrics": [
      "first_pass_target_accuracy",
      "correction_loops",
      "intent_shift_recovery",
      "clarification_precision",
      "redundant_question_rate",
      "wrong_target_material_actions",
      "acceptance_test_coverage",
      "stale_constraint_violations",
      "false_positive_completion_rate"
    ]
  },
  "release_gate": {
    "pass_requires": [
      "target_identity_evidenced",
      "goal_contract_converged_enough_for_action",
      "all_hard_goal_contract_criteria_satisfied",
      "highest_practical_owning_layer_verified",
      "protected_capabilities_preserved",
      "final_goal_drift_check_passed",
      "no_unresolved_high_impact_contradiction",
      "no_controller_evasion_or_headcount_substitution",
      "no_stale_constraint_violation",
      "completion_audit_passed_when_practical"
    ],
    "self_report_only_cannot_pass": true,
    "unknown_or_unverified_target_cannot_pass": true
  }
}
