{
  "schemaVersion": 2,
  "updated": "2026-08-27",
  "intent": "ordinary_chat_task",
  "requestSchemaVersion": 2,
  "allowedModes": ["execute", "audit"],
  "maxSteps": 32,
  "maxReadChars": 50000,
  "maxSearchFileBytes": 2097152,
  "maxSearchMatches": 200,
  "enabledActions": ["read_text", "search_text", "write_text", "replace_text", "json_set", "fetch_url", "run_recipe"],
  "mutation": {
    "globalAllowedPaths": ["docs/**", "skills/**", "systems/**", "research/**", "debates/**", "control-plane/**"],
    "protectedPaths": [
      "control-plane/scripts/ordinary_chat_task_runtime.py",
      "control-plane/ai-system/configs/ordinary-chat-task-runtime.json",
      "control-plane/ordinary-chat-task-requests/**",
      "control-plane/ordinary-chat-task-results/**"
    ]
  },
  "snapshotExclude": [".git/**", "**/.git/**", "**/node_modules/**", "**/dist/**", "**/__pycache__/**", ".ordinary-chat-task/**"],
  "fetch": {
    "allowedHosts": ["api.github.com", "github.com", "raw.githubusercontent.com", "registry.npmjs.org", "pypi.org", "files.pythonhosted.org", "modelcontextprotocol.io", "blog.modelcontextprotocol.io"],
    "maxBytes": 2097152,
    "timeoutSeconds": 30
  },
  "recipes": {
    "defaultTimeoutSeconds": 180,
    "passEnv": ["PATH", "HOME", "CI", "RUNNER_TEMP", "TMPDIR", "LANG", "LC_ALL"],
    "definitions": {
      "python-control-plane-tests": {
        "commands": [{"argv": ["python", "-m", "unittest", "discover", "-s", "control-plane/tests", "-p", "test_*.py"], "cwd": ".", "timeoutSeconds": 300}]
      },
      "python-compile-control-plane": {
        "commands": [{"argv": ["python", "-m", "compileall", "-q", "control-plane/scripts"], "cwd": ".", "timeoutSeconds": 120}]
      },
      "mcp-check": {
        "commands": [
          {"argv": ["npm", "ci", "--no-audit", "--no-fund"], "cwd": "control-plane/ai-system/mcp", "timeoutSeconds": 300},
          {"argv": ["npm", "run", "check"], "cwd": "control-plane/ai-system/mcp", "timeoutSeconds": 300}
        ]
      },
      "mcp-lockfile-refresh": {
        "commands": [
          {"argv": ["npm", "install", "--package-lock-only", "--ignore-scripts", "--no-audit", "--no-fund"], "cwd": "control-plane/ai-system/mcp", "timeoutSeconds": 300}
        ]
      }
    }
  }
}
