{
  "schema_version": 1,
  "policy_id": "root-cause-falsification-v1",
  "revision": "1.0.0",
  "default_enabled": true,
  "scope": "global_substantive_debug_repair_optimization_and_completion",
  "goal_fidelity": {
    "examples_are_nonbinding_unless_explicitly_promoted": true,
    "examples_must_not_be_frozen_into_constraints": true,
    "blocker_must_not_replace_root_goal": true,
    "nearest_easier_wrong_task_must_be_checked": true
  },
  "causal_model": {
    "required_chain": [
      "symptom",
      "exposing_condition",
      "mechanism",
      "owning_layer",
      "intervention",
      "predicted_state_change",
      "observable_test",
      "falsifier"
    ],
    "trigger_is_not_root_cause": true,
    "mutation_requires_mechanism_hypothesis": true,
    "prefer_discriminating_probe_before_mutation": true
  },
  "repair_semantics": {
    "classes": [
      "ROOT_FIX",
      "MITIGATION",
      "GUARDRAIL",
      "WORKAROUND",
      "DEGRADATION"
    ],
    "root_fix_requires_owning_mechanism_change": true,
    "limit_as_fix_forbidden": true,
    "throttling_as_fix_forbidden": true,
    "disable_feature_as_fix_forbidden": true,
    "capability_reduction_as_fix_forbidden": true,
    "workaround_cannot_claim_fixed": true,
    "mitigation_cannot_claim_fixed": true,
    "degradation_blocks_root_fix_verified": true,
    "patch_on_patch_without_architecture_recheck_forbidden": true
  },
  "falsification": {
    "universal_pass_invalidated_by_any_reproducible_in_scope_counterexample": true,
    "zero_failure_claim_requires_zero_reproducible_in_scope_failures": true,
    "verification_matrix_predeclared_before_results": true,
    "all_in_scope_trials_count": true,
    "success_cherry_picking_forbidden": true,
    "first_success_stop_forbidden": true,
    "original_failure_replay_required": true,
    "retain_and_replay_failures": true,
    "minimize_failing_case_when_practical": true,
    "negative_or_adversarial_check_required": true,
    "nearby_regression_check_required": true,
    "owning_runtime_readback_required_when_available": true,
    "probabilistic_claims_use_declared_slo_or_error_budget": true,
    "single_failure_refutes_never_fails_but_not_necessarily_nonzero_slo": true
  },
  "evidence_routing": {
    "contract_truth_priority": [
      "canonical_owner",
      "current_official_spec_or_docs",
      "exact_source_or_schema"
    ],
    "practical_behavior_priority": [
      "target_runtime",
      "independent_reproduction",
      "issue_pr_commit_failure_evidence",
      "independent_postmortem_or_production_report",
      "inspectable_benchmark",
      "current_relevant_maintainer",
      "official_support_boundary"
    ],
    "single_anecdote_is_lead_only": true,
    "multiple_independent_matching_reports_raise_hypothesis_priority": true,
    "collapse_correlated_lineages": true,
    "popularity_is_discovery_signal_not_proof": true,
    "official_docs_are_not_execution_proof": true,
    "official_unsupported_does_not_equal_empirically_impossible": true,
    "unsupported_but_working_must_be_labeled_unsupported_not_impossible": true
  },
  "research_execution_loop": {
    "required_order": [
      "local_observation",
      "competing_hypotheses",
      "independent_research",
      "source_qualification",
      "discriminating_target_test",
      "model_update",
      "mechanism_level_mutation",
      "readback",
      "falsification",
      "regression"
    ],
    "one_search_hit_direct_to_patch_forbidden": true,
    "external_evidence_proposes_or_prioritizes_hypotheses": true,
    "target_runtime_settles_local_applicability": true
  },
  "escalation": {
    "same_mechanism_no_delta_limit": 2,
    "three_failed_repairs_trigger_architecture_recheck": true,
    "next_attempt_must_change_major_dimension_after_limit": true
  },
  "completion": {
    "allowed_states": [
      "ROOT_CAUSE_PROVEN",
      "ROOT_FIX_VERIFIED",
      "MITIGATION_ONLY",
      "PARTIAL",
      "CONTESTED",
      "BLOCKED",
      "FAIL"
    ],
    "root_fix_verified_requires": [
      "goal_preserved",
      "mechanism_level_change_evidenced",
      "original_failure_not_reproducible_in_declared_scope",
      "protected_capability_not_degraded",
      "adversarial_and_regression_checks_pass",
      "no_reproducible_in_scope_counterexample"
    ],
    "configuration_presence_is_not_completion": true,
    "agent_self_report_is_not_completion": true
  }
}
